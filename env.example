# webcollect secrets — install.sh copies this to .env (gitignored); fill in what you use.
# Everything is optional: the pipeline runs $0 with no keys (free primaries + local embeddings).

# --- statistics (free API keys) ---
FRED_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
CENSUS_API_KEY=
BLS_API_KEY=

# --- reddit (OAuth "script" app — register one at https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=webcollect/0.1 by u_yourname

# --- optional paid embeddings (left empty for the free-first default) ---
VOYAGE_API_KEY=

# --- HTTP User-Agent sent by the fetchers (add a contact URL/email if a source asks for one) ---
WEBCOLLECT_USER_AGENT=

# --- where corpora live (machine-local; default ~/corpus) ---
CORPUS_ROOT=
